# Copy to .env and adjust. All settings use the NUTRILENS_ prefix.
NUTRILENS_DATABASE_URL=sqlite:///./nutrilens.db
# postgres example: postgresql+psycopg://user:pass@localhost:5432/nutrilens
NUTRILENS_VISION_PROVIDER=claude   # or "mock" to run without an API key
NUTRILENS_VISION_MODEL=claude-opus-5-5
NUTRILENS_VISION_EFFORT=medium
NUTRILENS_MEDIA_DIR=./media
NUTRILENS_MAX_UPLOAD_MB=10
# The Anthropic SDK reads ANTHROPIC_API_KEY (or an `ant auth login` profile).
ANTHROPIC_API_KEY=
